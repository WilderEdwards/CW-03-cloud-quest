<?xml version="1.0" encoding="utf-8"?>
<!--
  network_security_config.xml

  Android refuses plain http by default. The firebase emulators only speak http,
  and the android emulator finds the host machine at 10.0.2.2, so those three
  addresses are allowed to skip https. Everything else stays on https.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
